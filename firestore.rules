rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---- user profiles: each user owns their own doc ----
    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---- children: owned by the parent (parentId field) ----
    match /children/{childId} {
      allow read:   if signedIn() && resource.data.parentId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.parentId == request.auth.uid;
      allow update: if signedIn() && resource.data.parentId == request.auth.uid;
      allow delete: if signedIn() && resource.data.parentId == request.auth.uid;

      // growth records live under children/{childId}/growthRecords
      match /growthRecords/{recId} {
        function parentOf() {
          return get(/databases/$(database)/documents/children/$(childId)).data.parentId;
        }
        allow read:   if signedIn() && parentOf() == request.auth.uid;
        allow create: if signedIn() && parentOf() == request.auth.uid;
        allow update: if signedIn() && parentOf() == request.auth.uid;
        allow delete: if signedIn() && parentOf() == request.auth.uid;
      }
    }

    // ---- milestones: owned by the parent (parentId field) ----
    match /milestones/{id} {
      allow read:   if signedIn() && resource.data.parentId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.parentId == request.auth.uid;
      allow update: if signedIn() && resource.data.parentId == request.auth.uid;
      allow delete: if signedIn() && resource.data.parentId == request.auth.uid;
    }
  }
}
